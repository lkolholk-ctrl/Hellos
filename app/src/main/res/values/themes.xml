<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MobileCodeEditor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/vscode_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/vscode_accent</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSurface">@color/vscode_titlebar_bg</item>
        <item name="colorOnSurface">@color/vscode_text</item>
        <item name="android:colorBackground">@color/vscode_editor_bg</item>
        <item name="android:statusBarColor">@color/vscode_titlebar_bg</item>
        <item name="android:navigationBarColor">@color/vscode_titlebar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/vscode_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/vscode_text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>

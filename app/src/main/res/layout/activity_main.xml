<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main content ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vscode_titlebar_bg"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/vscode_titlebar_bg"
                app:title="@string/app_name"
                app:titleTextAppearance="@style/ToolbarTitle"
                app:subtitleTextAppearance="@style/ToolbarSubtitle" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/vscode_tab_bg"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/vscode_accent"
                app:tabIndicatorHeight="2dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp"
                app:tabMinWidth="0dp" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Editor + welcome screen stacked -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <io.github.rosemoe.sora.widget.CodeEditor
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/welcomeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/vscode_editor_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.85"
                    android:src="@drawable/ic_code"
                    app:tint="@color/vscode_accent"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/welcome_title"
                    android:textColor="@color/vscode_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/welcome_subtitle"
                    android:textColor="@color/vscode_text_dim"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/welcomeOpenFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/action_open_folder"
                    app:icon="@drawable/ic_folder" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/welcomeNewFile"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_new_file"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>
        </FrameLayout>

        <!-- Mobile symbol input bar -->
        <io.github.rosemoe.sora.widget.SymbolInputView
            android:id="@+id/symbolInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vscode_symbol_bg" />
    </LinearLayout>

    <!-- ===== Navigation drawer: file explorer ===== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/vscode_sidebar_bg"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vscode_titlebar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/explorer"
                android:textAllCaps="true"
                android:textColor="@color/vscode_text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDrawerOpenFolder"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_folder"
                android:src="@drawable/ic_folder_open"
                app:tint="@color/vscode_text" />

            <ImageButton
                android:id="@+id/btnDrawerRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh"
                app:tint="@color/vscode_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/folderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vscode_sidebar_bg"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/no_folder_open"
            android:textColor="@color/vscode_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
